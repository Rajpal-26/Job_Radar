# JobRadar Email Alerts & Daily Cron Configuration
# ==============================================================================

# Recipient email address for daily 50 job alerts
ALERT_RECIPIENT_EMAIL=rajpaltanwar2608@gmail.com

# SMTP Server Settings (Default: Gmail SMTP)
# For Gmail, generate an App Password from: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Daily Cron Schedule (24-hour format HH:MM)
DAILY_DIGEST_TIME=08:00
DAILY_DIGEST_JOB_LIMIT=50

# ==============================================================================
# Database Credentials & PGVector Vector Store Configuration
# ==============================================================================
DATABASE_URL=postgresql://jobradar_user:SecurePostgresPass2026@localhost:5432/jobradar_db
POSTGRES_USER=jobradar_user
POSTGRES_PASSWORD=SecurePostgresPass2026
POSTGRES_DB=jobradar_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer

# PGVector Vector Dimension & Embeddings (1536 for OpenAI, 768 for Gemini)
VECTOR_DIMENSION=1536
VECTOR_SIMILARITY_METRIC=cosine
EMBEDDING_MODEL_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
