# ── Python ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Virtual environment ────────────────────────────────────────────
venv/
.venv/
env/

# ── Secrets / local config ─────────────────────────────────────────
.env
.env.*
!.env.example

# ── Playwright / Patchright browser profiles ───────────────────────
# These persist cookies + Akamai trust tokens. Personal browser state,
# must NEVER be committed or shared.
_*_profile/

# ── Scrape exports + build artifacts ───────────────────────────────
jobs_*.xlsx
job_scout.zip

# ── Debug screenshots / HTML dumps (root-only — keep static/, public/) ─
/*.png
/*.jpg
/*.jpeg
_*_debug.html

# ── IDE / OS ───────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Claude Code project context (kept local, not for the public repo) ──
CLAUDE.md

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
node_modules/
bower_components/
jspm_packages/
site-packages/
coverage/
htmlcov/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
playwright-report/
test-results/
allure-results/
allure-report/
cdk.out/
*.dist-info/
eggs/
pip-wheel-metadata/
wheels/
